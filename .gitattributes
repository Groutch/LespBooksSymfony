# Fichiers de developpement exclus de `git archive`, donc de la livraison.
/tests export-ignore
/docker export-ignore
/deploy export-ignore
/compose.yaml export-ignore
/compose.override.yaml export-ignore
/Makefile export-ignore
/phpunit.dist.xml export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.editorconfig export-ignore
/NOTES-REPRISE.md export-ignore

# Environnements de dev et de test : inutiles en production, et porteurs
# d'un APP_SECRET qui n'a rien a faire sur le serveur.
/.env.dev export-ignore
/.env.test export-ignore
