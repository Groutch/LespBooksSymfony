{% extends 'base.html.twig' %}

{% block title %}Bibliothèque de Lespouey{% endblock %}

{% block body %}
<div class="min-h-screen">
    <header class="bg-white border-b border-slate-200">
        <div class="mx-auto max-w-5xl px-4 py-4 flex items-center justify-between">
            <a href="{{ path('home') }}" class="text-lg font-semibold">Bibliothèque de Lespouey</a>
            <a href="{{ path('app_login') }}" class="text-sm text-slate-600 hover:text-slate-900">Espace bénévoles</a>
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
        <p class="text-slate-600">{{ bookCount }} livre{{ bookCount > 1 ? 's' : '' }} au catalogue.</p>

        {% if categories is not empty %}
            <div class="mt-4 flex flex-wrap gap-2">
                {% for row in categories %}
                    <span class="rounded-full bg-white border border-slate-200 px-3 py-1 text-sm">
                        {{ row.category.name }} <span class="text-slate-400">{{ row.bookCount }}</span>
                    </span>
                {% endfor %}
            </div>
        {% endif %}

        <h2 class="mt-8 text-lg font-medium">Derniers ajouts</h2>
        {% if latestBooks is empty %}
            <p class="mt-2 text-slate-500">Le catalogue est encore vide.</p>
        {% else %}
            <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
                {% for book in latestBooks %}
                    <article class="rounded-xl border border-slate-200 bg-white p-3">
                        <p class="font-medium leading-snug">{{ book.title }}</p>
                        <p class="mt-1 text-sm text-slate-500">{{ book.authorNames|default('Auteur inconnu') }}</p>
                        {% if not book.available %}
                            <p class="mt-2 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-800">Emprunté</p>
                        {% endif %}
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </main>
</div>
{% endblock %}
