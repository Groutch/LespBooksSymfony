{% extends 'admin/layout.html.twig' %}

{% block title %}Prêter « {{ book.title }} »{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Prêter « {{ book.title }} »</h1>
    <a href="{{ path('admin_loan_index') }}" class="text-sm text-ink-muted hover:text-accent">Retour aux prêts</a>
</div>

<p class="mt-1 text-sm text-ink-muted">{{ book.authorNames|default('Auteur inconnu') }}</p>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    <div class="grid gap-x-4 sm:grid-cols-2">
        {{ form_row(form.borrowerFirstName) }}
        {{ form_row(form.borrowerLastName) }}
        {{ form_row(form.borrowedAt) }}
        {{ form_row(form.dueAt) }}
        <div class="sm:col-span-2">{{ form_row(form.notes) }}</div>
    </div>

    <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer le prêt</button>
        <a href="{{ path('admin_book_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
{{ form_end(form) }}
{% endblock %}
