{% extends 'admin/layout.html.twig' %}

{% block title %}Rayons{% endblock %}

{% block admin_content %}
<h1 class="font-display text-2xl font-semibold tracking-tight">
    Rayons <span class="font-sans text-lg font-normal text-ink-faint tabular">({{ genres|length }})</span>
</h1>
<p class="mt-1 max-w-[62ch] text-sm text-ink-muted">
    Le rayon est l'endroit où le livre est physiquement rangé. Chaque livre en a un seul.
</p>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    <div class="flex flex-wrap items-end gap-3">
        <div class="min-w-64 flex-1">{{ form_row(form.name) }}</div>
        <button type="submit" class="btn btn-primary mb-5">Ajouter le rayon</button>
    </div>
{{ form_end(form) }}

{% if genres is empty %}
    <p class="mt-6 rounded-xs border border-dashed border-line-field p-10 text-center text-ink-muted">
        Aucun rayon. Créez-les d'abord, ils seront ensuite proposés à chaque scan.
    </p>
{% else %}
    <ul class="surface mt-5 divide-y divide-line">
        {% for genre in genres %}
            <li class="flex items-center gap-3 px-4 py-3">
                <div class="min-w-0 flex-1">
                    <p class="truncate font-medium">{{ genre.name }}</p>
                    <p class="text-sm text-ink-muted">{{ genre.books|length }} livre{{ genre.books|length > 1 ? 's' }}</p>
                </div>
                <a href="{{ path('admin_genre_edit', {id: genre.id}) }}" class="btn btn-ghost shrink-0 px-3 text-sm">Modifier</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}
