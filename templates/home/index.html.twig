{% extends 'public/layout.html.twig' %}

{% block title %}Bibliothèque de Lespouey{% endblock %}

{% block public_content %}
{#- Le titre est pose a meme le papier, sans carte : c'est l'entree de la page,
    pas un widget parmi d'autres. -#}
<section>
    <h1 class="font-display text-4xl font-semibold leading-[1.06] tracking-tight sm:text-5xl">
        {{ bookCount }} livre{{ bookCount > 1 ? 's' }},<br>à deux pas de chez vous.
    </h1>
    <p class="mt-3 text-ink-muted">Le catalogue de la bibliothèque communautaire, en accès libre.</p>

    <form method="get" action="{{ path('catalog_index') }}" class="mt-6 flex max-w-xl gap-2">
        <label for="recherche-accueil" class="sr-only">Rechercher un livre</label>
        <input id="recherche-accueil" type="search" name="q" class="field" placeholder="Titre, auteur, éditeur, ISBN…">
        <button type="submit" class="btn btn-primary shrink-0">Chercher</button>
    </form>
</section>

{% if categories is not empty %}
    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Parcourir par catégorie">
        {% for row in categories %}
            <a href="{{ path('catalog_index', {categorie: row.category.slug}) }}" class="chip hover:border-accent hover:text-accent">
                {{ row.category.name }} <span class="text-ink-faint tabular">{{ row.bookCount }}</span>
            </a>
        {% endfor %}
    </nav>
{% endif %}

<hr class="my-10 border-line">

<div class="flex items-baseline justify-between gap-4">
    <h2 class="font-display text-xl font-semibold tracking-tight">Derniers ajouts</h2>
    <a href="{{ path('catalog_index') }}" class="text-sm text-accent hover:underline">Voir tout le catalogue →</a>
</div>

{% if latestBooks is empty %}
    <p class="mt-4 text-ink-muted">Le catalogue est encore vide.</p>
{% else %}
    <div class="mt-5 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-5">
        {% for book in latestBooks %}
            {{ include('catalog/_card.html.twig') }}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
