{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier « {{ category.name }} »{% endblock %}

{% block admin_content %}
<div class="flex items-center justify-between gap-4">
    <h1 class="text-xl font-semibold">Modifier « {{ category.name }} »</h1>
    <a href="{{ path('admin_category_index') }}" class="text-sm text-slate-600 hover:text-slate-900">Retour à la liste</a>
</div>

<p class="mt-1 text-sm text-slate-500">{{ category.books|length }} livre{{ category.books|length > 1 ? 's' }} rattaché{{ category.books|length > 1 ? 's' }}.</p>

{{ form_start(form, {attr: {class: 'mt-5 rounded-xl border border-slate-200 bg-white p-4'}}) }}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {{ form_row(form.name) }}
        {{ form_row(form.shelfCode) }}
        <div class="sm:col-span-2">{{ form_row(form.description) }}</div>
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
        <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700">
            Enregistrer
        </button>
        <a href="{{ path('admin_category_index') }}" class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50">
            Annuler
        </a>
    </div>
{{ form_end(form) }}

{% if others is not empty %}
    <div class="mt-6 rounded-xl border border-slate-200 bg-white p-4">
        <h2 class="font-medium">Fusionner dans une autre catégorie</h2>
        <p class="mt-1 text-sm text-slate-500">
            Les livres de « {{ category.name }} » seront rattachés à la catégorie choisie,
            puis « {{ category.name }} » sera supprimée. Aucun livre n'est perdu.
        </p>
        <form method="post" action="{{ path('admin_category_merge') }}" class="mt-3 flex flex-wrap items-center gap-2"
              onsubmit="return confirm('Fusionner « {{ category.name|e('js') }} » dans la catégorie choisie ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('fusionner-categories') }}">
            <input type="hidden" name="source" value="{{ category.id }}">
            <select name="target" class="rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
                {% for other in others %}
                    <option value="{{ other.id }}">{{ other.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50">Fusionner</button>
        </form>
    </div>
{% endif %}

<form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="mt-6"
      onsubmit="return confirm('Supprimer « {{ category.name|e('js') }} » ? Les livres seront conservés.');">
    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-categorie-' ~ category.id) }}">
    <button type="submit" class="text-sm text-red-700 hover:underline">Supprimer cette catégorie</button>
</form>
{% endblock %}
