{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-10">
        <div class="mx-auto max-w-5xl px-4 py-3 flex items-center justify-between gap-4">
            <a href="{{ path('admin_dashboard') }}" class="font-semibold whitespace-nowrap">Administration</a>
            <nav class="flex items-center gap-3 text-sm">
                <a href="{{ path('admin_book_index') }}" class="text-slate-600 hover:text-slate-900">Livres</a>
                <a href="{{ path('admin_category_index') }}" class="text-slate-600 hover:text-slate-900">Catégories</a>
                <a href="{{ path('admin_loan_index') }}" class="text-slate-600 hover:text-slate-900">Prêts</a>
                <a href="{{ path('admin_book_scan') }}" class="rounded-lg bg-emerald-600 px-3 py-1.5 font-medium text-white hover:bg-emerald-700">Scanner</a>
                <a href="{{ path('home') }}" class="text-slate-600 hover:text-slate-900">Voir le site</a>
                <a href="{{ path('app_logout') }}" class="text-slate-600 hover:text-slate-900">Quitter</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-6">
        {% for label, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="mb-4 rounded-lg px-4 py-3 text-sm {{ label == 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : 'bg-red-50 text-red-800 border border-red-200' }}">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}
