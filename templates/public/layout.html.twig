{% extends 'base.html.twig' %}

{% block body %}
<div class="flex min-h-screen flex-col">
    <header class="border-b border-line bg-surface">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-4">
            <a href="{{ path('home') }}" class="font-display text-lg font-semibold tracking-tight">
                Bibliothèque de Lespouey
            </a>
            <nav class="flex items-center gap-4 text-sm sm:gap-5">
                <a href="{{ path('catalog_index') }}" class="text-ink-muted hover:text-accent">Rechercher un livre</a>

                {#- Quitter l'administration et se deconnecter menent tous deux ici :
                    sans repere, impossible de savoir si la session est encore ouverte.
                    Sur un telephone partage entre benevoles, c'est ce qui fait qu'on
                    repart en croyant etre sorti. -#}
                {% if app.user %}
                    <a href="{{ path('admin_dashboard') }}"
                       class="chip hover:border-accent hover:text-accent"
                       title="Vous êtes connecté — retourner à l'administration">
                        <span class="size-1.5 shrink-0 rounded-full bg-success" aria-hidden="true"></span>
                        <span class="sm:hidden">Connecté</span>
                        <span class="hidden sm:inline">Connecté&nbsp;: {{ app.user.displayName|default('bénévole') }}</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_login') }}" class="text-ink-muted hover:text-accent">Espace bénévoles</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-5 py-10">
        {% block public_content %}{% endblock %}
    </main>

    <footer class="border-t border-line bg-surface">
        <div class="mx-auto max-w-6xl px-5 py-6 text-sm text-ink-muted">
            Bibliothèque communautaire de Lespouey.
        </div>
    </footer>
</div>
{% endblock %}
