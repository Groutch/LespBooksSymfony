{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen">
    <header class="sticky top-0 z-10 border-b border-line bg-surface">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-5 gap-y-2 px-5 py-3">
            <a href="{{ path('admin_dashboard') }}" class="font-display font-semibold tracking-tight whitespace-nowrap">
                Administration
            </a>

            <nav class="flex flex-1 flex-wrap items-center gap-x-4 gap-y-1 text-sm">
                <a href="{{ path('admin_book_index') }}" class="text-ink-muted hover:text-accent">Livres</a>
                <a href="{{ path('admin_genre_index') }}" class="text-ink-muted hover:text-accent">Rayons</a>
                <a href="{{ path('admin_category_index') }}" class="text-ink-muted hover:text-accent">Catégories</a>
                <a href="{{ path('admin_loan_index') }}" class="text-ink-muted hover:text-accent">Prêts</a>
            </nav>

            <div class="flex items-center gap-4 text-sm">
                <a href="{{ path('home') }}" class="text-ink-muted hover:text-accent">Voir le site</a>
                <a href="{{ path('app_logout') }}" class="text-ink-muted hover:text-accent">Quitter</a>
                <a href="{{ path('admin_book_scan') }}" class="btn btn-primary">Scanner</a>
            </div>
        </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-8">
        {% for label, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="alert {{ label == 'success' ? 'alert-success' : 'alert-error' }} mb-5 text-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}
