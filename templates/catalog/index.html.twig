{% extends 'public/layout.html.twig' %}

{% block title %}Rechercher un livre{% endblock %}

{% block public_content %}
<h1 class="text-xl font-semibold">Rechercher un livre</h1>

<form method="get" class="mt-4 rounded-xl border border-slate-200 bg-white p-4">
    <div class="flex gap-2">
        <input type="search" name="q" value="{{ criteria.query }}" placeholder="Titre, auteur, éditeur, ISBN…"
               class="flex-1 rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        <button type="submit" class="rounded-lg bg-slate-800 px-4 py-2 font-medium text-white hover:bg-slate-900">Chercher</button>
    </div>

    <div class="mt-3 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 text-sm">
        <label class="block">
            <span class="text-slate-600">Catégorie</span>
            <select name="categorie" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5">
                <option value="">Toutes</option>
                {% for category in categories %}
                    <option value="{{ category.slug }}" {{ category.slug == criteria.category ? 'selected' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="block">
            <span class="text-slate-600">Genre</span>
            <select name="genre" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5">
                <option value="">Tous</option>
                {% for genre in genres %}
                    <option value="{{ genre.slug }}" {{ genre.slug == criteria.genre ? 'selected' }}>{{ genre.name }}</option>
                {% endfor %}
            </select>
        </label>

        <label class="block">
            <span class="text-slate-600">Année min.</span>
            <input type="number" name="anneeMin" value="{{ criteria.yearFrom }}" min="1400" max="2200"
                   class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5">
        </label>

        <label class="block">
            <span class="text-slate-600">Année max.</span>
            <input type="number" name="anneeMax" value="{{ criteria.yearTo }}" min="1400" max="2200"
                   class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5">
        </label>

        <label class="block">
            <span class="text-slate-600">Trier par</span>
            <select name="tri" class="mt-1 w-full rounded-lg border border-slate-300 px-2 py-1.5">
                <option value="recent" {{ criteria.sort == 'recent' ? 'selected' }}>Ajout récent</option>
                <option value="title" {{ criteria.sort == 'title' ? 'selected' }}>Titre</option>
                <option value="year" {{ criteria.sort == 'year' ? 'selected' }}>Année</option>
            </select>
        </label>
    </div>

    <div class="mt-3 flex flex-wrap items-center gap-4 text-sm">
        <label class="flex items-center gap-2 text-slate-600">
            <input type="checkbox" name="disponibles" value="1" {{ criteria.availableOnly ? 'checked' }} class="rounded border-slate-300">
            Disponibles seulement
        </label>

        {% if selectedAuthor %}
            <span class="rounded-full bg-slate-100 px-3 py-1">
                Auteur : {{ selectedAuthor.name }}
                <input type="hidden" name="auteur" value="{{ selectedAuthor.slug }}">
            </span>
        {% endif %}

        {% if criteria.hasFilters %}
            <a href="{{ path('catalog_index') }}" class="text-slate-500 hover:text-slate-800">Tout effacer</a>
        {% endif %}
    </div>
</form>

<p class="mt-5 text-slate-600">{{ total }} résultat{{ total > 1 ? 's' }}.</p>

{% if total == 0 %}
    <p class="mt-4 rounded-xl border border-dashed border-slate-300 p-8 text-center text-slate-500">
        Aucun livre ne correspond à cette recherche.
    </p>
{% else %}
    <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {% for book in books %}
            {{ include('catalog/_card.html.twig') }}
        {% endfor %}
    </div>

    {% if pageCount > 1 %}
        <div class="mt-6 flex flex-wrap gap-1">
            {% for p in 1..pageCount %}
                <a href="{{ path('catalog_index', app.request.query.all|merge({page: p})) }}"
                   class="rounded px-3 py-1.5 text-sm {{ p == criteria.page ? 'bg-slate-800 text-white' : 'border border-slate-300 bg-white hover:bg-slate-50' }}">{{ p }}</a>
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
{% endblock %}
