{% extends 'admin/layout.html.twig' %}

{% block title %}Tableau de bord{% endblock %}

{% block admin_content %}
{#- Le manifeste ouvre l'application installee sur cette page : elle doit dire ou
    l'on se trouve avant d'aligner des chiffres. Le site public porte son titre en
    tete, l'administration n'en avait aucun. -#}
<div class="mb-6">
    <h1 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">Bibliothèque de Lespouey</h1>
    <p class="mt-1 text-ink-muted">Gestion du catalogue, des rayons et des prêts.</p>
</div>

<div class="grid gap-4 sm:grid-cols-3">
    {% for tile in [
        {label: 'Livres', count: bookCount, href: path('admin_book_index'), action: 'Gérer les livres'},
        {label: 'Prêts en cours', count: activeLoanCount, href: path('admin_loan_index'), action: 'Gérer les prêts'}
    ] %}
        <div class="surface p-4">
            <p class="text-sm text-ink-muted">{{ tile.label }}</p>
            <p class="mt-1 font-display text-3xl font-semibold tabular">{{ tile.count }}</p>
            <a href="{{ tile.href }}" class="mt-1 inline-block text-sm text-accent hover:underline">{{ tile.action }}</a>
        </div>
    {% endfor %}
</div>

{% if overdueLoans is not empty %}
    <div class="alert mt-6 border-warning-line bg-warning-wash p-4">
        <h2 class="font-display font-semibold text-warning">Prêts en retard</h2>
        <ul class="mt-2 space-y-1 text-sm text-warning">
            {% for loan in overdueLoans %}
                <li>{{ loan.book.title }} — {{ loan.borrowerName }} (échéance <time datetime="{{ loan.dueAt|date('Y-m-d') }}">{{ loan.dueAt|date('d/m/Y') }}</time>)</li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

<h2 class="mt-10 font-display text-xl font-semibold tracking-tight">Derniers livres ajoutés</h2>
{% if latestBooks is empty %}
    <p class="mt-2 text-ink-muted">
        Aucun livre pour l'instant.
        <a href="{{ path('admin_book_scan') }}" class="text-accent hover:underline">Scannez le premier</a>.
    </p>
{% else %}
    <ul class="surface mt-4 divide-y divide-line">
        {% for book in latestBooks %}
            <li class="px-4 py-3">
                <p class="font-medium">{{ book.title }}</p>
                <p class="text-sm text-ink-muted">{{ book.authorNames|default('Auteur inconnu') }}</p>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}
