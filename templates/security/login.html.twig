{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="flex min-h-screen items-center justify-center px-5 py-10">
    <div class="w-full max-w-sm">
        <div class="surface p-6">
            <h1 class="font-display text-2xl font-semibold tracking-tight">Espace bénévoles</h1>
            <p class="mt-1 text-sm text-ink-muted">Bibliothèque de Lespouey</p>

            {% if error %}
                <p class="alert alert-error mt-5 text-sm">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </p>
            {% endif %}

            <form method="post" class="mt-6 space-y-4">
                <div>
                    <label for="username" class="mb-1 block text-sm font-medium">Adresse e-mail</label>
                    <input type="email" id="username" name="_username" value="{{ last_username }}"
                           autocomplete="email" required autofocus class="field">
                </div>

                <div>
                    <label for="password" class="mb-1 block text-sm font-medium">Mot de passe</label>
                    <input type="password" id="password" name="_password" autocomplete="current-password" required class="field">
                </div>

                <label class="flex min-h-11 items-center gap-2 text-sm text-ink-muted">
                    <input type="checkbox" name="_remember_me" class="size-4 accent-accent">
                    Rester connecté
                </label>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="btn btn-primary w-full">Se connecter</button>
            </form>
        </div>

        <p class="mt-5 text-center text-sm text-ink-muted">
            <a href="{{ path('home') }}" class="hover:text-accent">Retour au catalogue</a>
        </p>
    </div>
</div>
{% endblock %}
