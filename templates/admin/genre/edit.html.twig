{% extends 'admin/layout.html.twig' %}

{% block title %}Rayon « {{ genre.name }} »{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Rayon « {{ genre.name }} »</h1>
    <a href="{{ path('admin_genre_index') }}" class="text-sm text-ink-muted hover:text-accent">Retour aux rayons</a>
</div>

<p class="mt-1 text-sm text-ink-muted">
    {{ genre.books|length }} livre{{ genre.books|length > 1 ? 's' }} rangé{{ genre.books|length > 1 ? 's' }} ici.
</p>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    {{ form_row(form.name) }}

    <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('admin_genre_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
{{ form_end(form) }}

<form method="post" action="{{ path('admin_genre_delete', {id: genre.id}) }}" class="mt-8"
      onsubmit="return confirm('Supprimer le rayon « {{ genre.name|e('js') }} » ? Les livres seront conservés, sans rayon.');">
    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-rayon-' ~ genre.id) }}">
    <button type="submit" class="text-sm text-danger underline underline-offset-2 hover:no-underline">Supprimer ce rayon</button>
</form>
{% endblock %}
