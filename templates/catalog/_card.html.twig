{#- Reste un <article> : CatalogTest compte les resultats avec filter('article'). -#}
<article class="group flex h-full flex-col">
    <a href="{{ path('catalog_book', {id: book.id}) }}" class="relative block">
        {% if book.primaryImage and book.primaryImage.imageName %}
            <img src="{{ vich_uploader_asset(book.primaryImage, 'imageFile') }}" alt="Couverture de {{ book.title }}"
                 class="aspect-2/3 w-full rounded-xs bg-surface-sunk object-cover shadow-cover transition group-hover:shadow-cover-lg"
                 loading="lazy">
        {% else %}
            {#- Sans couverture, le livre garde sa place et son titre : c'est frequent
                dans ce catalogue, ca ne doit pas ressembler a une image cassee. -#}
            <div class="flex aspect-2/3 w-full items-center justify-center rounded-xs bg-surface-sunk p-3 text-center font-display text-sm text-ink-muted shadow-cover">
                {{ book.title }}
            </div>
        {% endif %}

        {% if not book.available %}
            <span class="chip chip-warn absolute left-2 top-2 text-xs">Emprunté</span>
        {% endif %}
    </a>

    <div class="flex flex-1 flex-col pt-2.5">
        <a href="{{ path('catalog_book', {id: book.id}) }}"
           class="line-clamp-2 text-sm font-medium leading-snug group-hover:text-accent">{{ book.title }}</a>
        <p class="mt-0.5 line-clamp-1 text-sm text-ink-muted">{{ book.authorNames|default('Auteur inconnu') }}</p>
        {% if book.publishedYear %}
            <p class="mt-auto pt-1 text-xs text-ink-faint tabular">{{ book.publishedYear }}</p>
        {% endif %}
    </div>
</article>
