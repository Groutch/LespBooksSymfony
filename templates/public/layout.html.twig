{% extends 'base.html.twig' %}
{% import 'public/_bibliotheque.html.twig' as biblio %}

{% block body %}
<div class="flex min-h-screen flex-col">
    {#- Bandeau d'administration : volontairement etranger au site public, fond
        encre sur un site creme. Une pastille d'etat ne suffisait pas — elle disait
        « vous etes connecte » sans montrer par ou revenir. Ce bandeau separe les
        deux mondes a l'oeil et porte le chemin de retour. -#}
    {% if app.user %}
        <div class="bg-ink text-paper">
            <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-4 gap-y-1 px-5 py-2 text-sm">
                <span class="text-line">
                    Connecté&nbsp;: <span class="text-paper">{{ app.user.displayName|default('bénévole') }}</span>
                </span>
                <span class="flex items-center gap-4">
                    <a href="{{ path('admin_dashboard') }}"
                       class="rounded-xs bg-paper px-2.5 py-1 font-medium text-ink hover:bg-surface">
                        Gestion
                    </a>
                    <a href="{{ path('app_logout') }}" class="text-line hover:text-paper">Se déconnecter</a>
                </span>
            </div>
        </div>
    {% endif %}

    <header class="border-b border-line bg-surface">
        <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-5 py-4">
            <a href="{{ path('home') }}" class="font-display text-lg font-semibold tracking-tight">
                Bibliothèque de Lespouey
            </a>
            {#- Trois liens ne tiennent plus sur une ligne de 360 px : ils passent a la ligne. -#}
            <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm sm:gap-x-5">
                <a href="{{ path('catalog_index') }}" class="text-ink-muted hover:text-accent">Rechercher un livre</a>
                <a href="{{ path('practical_info') }}" class="text-ink-muted hover:text-accent">Infos pratiques</a>

                {#- Inutile quand la session est ouverte : le bandeau du dessus porte
                    deja l'acces a l'administration et la deconnexion. -#}
                {% if not app.user %}
                    <a href="{{ path('app_login') }}" class="text-ink-muted hover:text-accent">Espace bénévoles</a>
                {% endif %}
            </nav>
        </div>
    </header>

    <main class="mx-auto w-full max-w-6xl flex-1 px-5 py-10">
        {% block public_content %}{% endblock %}
    </main>

    {#- Ou et quand venir, sur chaque page : c'est la premiere question d'un
        habitant, avant meme celle d'un titre. -#}
    <footer class="border-t border-line bg-surface">
        <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-x-10 gap-y-5 px-5 py-8 text-sm text-ink-muted">
            <div>
                <p class="font-medium text-ink">Bibliothèque communautaire de Lespouey</p>
                <address class="mt-1 not-italic">{{ bibliotheque.adresse|join(', ') }}</address>
                <p class="mt-1">Ouverte {{ biblio.horaires_en_phrase(bibliotheque.horaires) }}.</p>
                <p class="mt-1">
                    <a href="mailto:{{ bibliotheque.courriel }}" class="underline underline-offset-2 hover:text-accent">{{ bibliotheque.courriel }}</a>
                </p>
            </div>
            <nav class="flex flex-wrap items-start gap-x-5" aria-label="À propos du site">
                <a href="{{ path('practical_info') }}" class="py-1 hover:text-accent">Infos pratiques</a>
                <a href="{{ path('legal_notice') }}" class="py-1 hover:text-accent">Mentions légales</a>
                <a href="{{ path('privacy_policy') }}" class="py-1 hover:text-accent">Confidentialité</a>
            </nav>
        </div>
    </footer>
</div>
{% endblock %}
