{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen">
    <header class="bg-white border-b border-slate-200">
        <div class="mx-auto max-w-5xl px-4 py-4 flex flex-wrap items-center justify-between gap-3">
            <a href="{{ path('home') }}" class="text-lg font-semibold">Bibliothèque de Lespouey</a>
            <nav class="flex items-center gap-4 text-sm">
                <a href="{{ path('catalog_index') }}" class="text-slate-600 hover:text-slate-900">Rechercher un livre</a>
                <a href="{{ path('app_login') }}" class="text-slate-600 hover:text-slate-900">Espace bénévoles</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-4 py-8">
        {% block public_content %}{% endblock %}
    </main>

    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-slate-500">
            Bibliothèque communautaire de Lespouey.
        </div>
    </footer>
</div>
{% endblock %}
