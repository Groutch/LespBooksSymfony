{% extends 'admin/layout.html.twig' %}
{% import 'admin/book/_form_fields.html.twig' as fields %}

{% block title %}Modifier « {{ book.title }} »{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Modifier « {{ book.title }} »</h1>
    <a href="{{ path('admin_book_index') }}" class="text-sm text-ink-muted hover:text-accent">Retour à la liste</a>
</div>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    {% if book.primaryImage and book.primaryImage.imageName %}
        <img src="{{ vich_uploader_asset(book.primaryImage, 'imageFile') }}" alt="Couverture de {{ book.title }}"
             class="mb-5 h-44 w-auto rounded-xs shadow-cover">
    {% endif %}

    {{ fields.fields(form, knownCategories) }}

    <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('admin_book_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
{{ form_end(form) }}

<form method="post" action="{{ path('admin_book_delete', {id: book.id}) }}" class="mt-8"
      onsubmit="return confirm('Supprimer définitivement « {{ book.title|e('js') }} » ? Cette action est irréversible.');">
    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-livre-' ~ book.id) }}">
    <button type="submit" class="text-sm text-danger underline underline-offset-2 hover:no-underline">Supprimer ce livre</button>
</form>
{% endblock %}
