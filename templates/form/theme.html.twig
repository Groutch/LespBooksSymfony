{% use 'form_div_layout.html.twig' %}

{#- Habille les formulaires Symfony aux couleurs du site : sans ce theme, les
    champs sont rendus sans classes et les libelles se collent aux widgets.

    Attention : ce theme ne peut surcharger que des blocs *existants* de
    `form_div_layout.html.twig`. Il n'y a pas de `file_widget` ; un `parent()`
    dessus casserait toutes les pages portant un champ fichier. -#}

{%- block form_row -%}
    {%- set row_attr = row_attr|merge({class: row_attr.class|default('mb-5')}) -%}
    {{- parent() -}}
{%- endblock form_row -%}

{%- block form_label -%}
    {%- set label_attr = label_attr|merge({class: label_attr.class|default('mb-1 block text-sm font-medium text-ink')}) -%}
    {{- parent() -}}
{%- endblock form_label -%}

{#- Tout le style du champ tient desormais dans la classe `field`, definie une
    seule fois dans `assets/styles/app.css`. C'est la raison d'etre de la couche
    de composants : ici, le style ne peut pas s'ecrire dans un gabarit. -#}
{%- block widget_attributes -%}
    {%- set attr = attr|merge({class: attr.class|default('field')}) -%}
    {%- if errors|length -%}
        {%- set attr = attr|merge({'aria-invalid': 'true'}) -%}
    {%- endif -%}
    {{- parent() -}}
{%- endblock widget_attributes -%}

{%- block textarea_widget -%}
    {%- set attr = attr|merge({rows: attr.rows|default(4)}) -%}
    {{- parent() -}}
{%- endblock textarea_widget -%}

{#- La case a cocher ne prend pas `field` : elle n'occupe pas la largeur et
    n'a pas de hauteur minimale de 44 px. -#}
{%- block checkbox_widget -%}
    {%- set attr = attr|merge({class: attr.class|default('size-4 accent-accent')}) -%}
    {{- parent() -}}
{%- endblock checkbox_widget -%}

{%- block form_help -%}
    {%- set help_attr = help_attr|merge({class: help_attr.class|default('mt-1 text-xs text-ink-muted')}) -%}
    {{- parent() -}}
{%- endblock form_help -%}

{#- Les erreurs restent dans une liste : `CategoryAdminTest` s'y accroche
    (`assertSelectorTextContains('li', ...)`), et c'est aussi la structure la
    plus juste pour un lecteur d'ecran. -#}
{%- block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="mt-1 space-y-0.5">
            {%- for error in errors -%}
                <li class="text-sm text-danger" id="{{ id ~ '_error' ~ loop.index }}">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors -%}
