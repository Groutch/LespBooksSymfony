{% extends 'admin/layout.html.twig' %}
{% import 'admin/book/_form_fields.html.twig' as fields %}

{% block title %}Ajouter un livre{% endblock %}

{% block admin_content %}
<div data-controller="isbn-autofill"
     data-isbn-autofill-lookup-url-value="{{ path('admin_book_lookup', {isbn: '0000000000000'}) }}"
     data-isbn-autofill-isbn-value="{{ prefillIsbn ?? '' }}">

    <div class="flex items-center justify-between gap-4">
        <h1 class="text-xl font-semibold">Ajouter un livre</h1>
        <a href="{{ path('admin_book_scan') }}" class="text-sm text-emerald-700 hover:underline">Scanner un autre code</a>
    </div>

    {% if prefillIsbn %}
        <p data-isbn-autofill-target="status" class="mt-3 rounded-lg bg-slate-100 px-3 py-2 text-sm text-slate-600">
            Recherche des informations du livre…
        </p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'mt-5 rounded-xl border border-slate-200 bg-white p-4'}}) }}
        <img data-isbn-autofill-target="coverPreview" alt="Couverture proposée"
             class="hidden mb-4 h-40 w-auto rounded border border-slate-200">
        <input type="hidden" name="coverUrl" value="" data-isbn-autofill-target="coverUrl">

        {{ fields.fields(form, knownCategories) }}

        <div class="mt-5 flex flex-wrap gap-2">
            <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700">
                Enregistrer
            </button>
            <button type="submit" name="saveAndScan" value="1"
                    class="rounded-lg border border-emerald-600 px-4 py-2 font-medium text-emerald-700 hover:bg-emerald-50">
                Enregistrer et scanner le suivant
            </button>
            <a href="{{ path('admin_book_index') }}" class="rounded-lg border border-slate-300 px-4 py-2 font-medium text-slate-700 hover:bg-slate-50">
                Annuler
            </a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
