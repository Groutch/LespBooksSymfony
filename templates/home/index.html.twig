{% extends 'public/layout.html.twig' %}

{% block title %}Bibliothèque de Lespouey{% endblock %}

{% block public_content %}
<section class="rounded-xl border border-slate-200 bg-white p-6">
    <h1 class="text-2xl font-semibold">Bibliothèque de Lespouey</h1>
    <p class="mt-1 text-slate-600">{{ bookCount }} livre{{ bookCount > 1 ? 's' }} au catalogue, en accès libre.</p>

    <form method="get" action="{{ path('catalog_index') }}" class="mt-4 flex gap-2">
        <input type="search" name="q" placeholder="Titre, auteur, éditeur, ISBN…"
               class="flex-1 rounded-lg border border-slate-300 px-3 py-2 focus:border-emerald-500 focus:outline-none focus:ring-1 focus:ring-emerald-500">
        <button type="submit" class="rounded-lg bg-emerald-600 px-4 py-2 font-medium text-white hover:bg-emerald-700">Chercher</button>
    </form>
</section>

{% if categories is not empty %}
    <div class="mt-6 flex flex-wrap gap-2">
        {% for row in categories %}
            <a href="{{ path('catalog_index', {categorie: row.category.slug}) }}"
               class="rounded-full bg-white border border-slate-200 px-3 py-1 text-sm hover:bg-slate-50">
                {{ row.category.name }} <span class="text-slate-400">{{ row.bookCount }}</span>
            </a>
        {% endfor %}
    </div>
{% endif %}

<div class="mt-8 flex items-center justify-between gap-4">
    <h2 class="text-lg font-medium">Derniers ajouts</h2>
    <a href="{{ path('catalog_index') }}" class="text-sm text-emerald-700 hover:underline">Voir tout le catalogue</a>
</div>

{% if latestBooks is empty %}
    <p class="mt-2 text-slate-500">Le catalogue est encore vide.</p>
{% else %}
    <div class="mt-4 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
        {% for book in latestBooks %}
            {{ include('catalog/_card.html.twig') }}
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
