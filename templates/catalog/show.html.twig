{% extends 'public/layout.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block public_content %}
<a href="{{ path('catalog_index') }}" class="text-sm text-ink-muted hover:text-accent">← Retour à la recherche</a>

<div class="mt-6 grid gap-8 sm:grid-cols-[260px_1fr] sm:gap-10">
    <div>
        {% if book.primaryImage and book.primaryImage.imageName %}
            <img src="{{ vich_uploader_asset(book.primaryImage, 'imageFile') }}" alt="Couverture de {{ book.title }}"
                 class="aspect-2/3 w-full rounded-xs bg-surface-sunk object-cover shadow-cover-lg">
        {% else %}
            <div class="flex aspect-2/3 w-full items-center justify-center rounded-xs bg-surface-sunk p-4 text-center font-display text-ink-muted shadow-cover">
                {{ book.title }}
            </div>
        {% endif %}

        {% if book.available %}
            {#- Le rayon est porte par `Genre` et affiche sous son propre intitule
                plus bas : le repeter ici serait du bruit. Cette ligne ne dit plus
                que la disponibilite. -#}
            <p class="alert alert-success mt-4 text-sm">
                <strong class="font-medium">Disponible</strong>
            </p>
        {% else %}
            {# Aucun nom d'emprunteur ici : le site est public. #}
            <p class="alert mt-4 border-warning-line bg-warning-wash text-sm text-warning">
                <strong class="font-medium">Emprunté</strong>
                {%- if book.activeLoan.dueAt %}, retour prévu le <time datetime="{{ book.activeLoan.dueAt|date('Y-m-d') }}">{{ book.activeLoan.dueAt|date('d/m/Y') }}</time>{% endif %}
            </p>
        {% endif %}
    </div>

    <div>
        <h1 class="font-display text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">{{ book.title }}</h1>
        {% if book.subtitle %}
            <p class="mt-2 font-display text-xl text-ink-muted">{{ book.subtitle }}</p>
        {% endif %}

        {#- L'auteur est une signature, pas une etiquette : il ne doit pas se
            confondre avec un rayon ni avec un theme, comme c'etait le cas quand
            les trois sortaient en pastilles identiques. -#}
        {% if book.authors is not empty %}
            <p class="mt-3 text-lg">
                par
                {% for author in book.authors %}
                    <a href="{{ path('catalog_index', {auteur: author.slug}) }}"
                       class="text-accent underline underline-offset-2 hover:no-underline">{{ author.name }}</a>{% if not loop.last %}, {% endif %}
                {% endfor %}
            </p>
        {% endif %}

        {% if book.genre %}
            <p class="mt-6 text-xs font-medium uppercase tracking-wider text-ink-faint">Rayon</p>
            <p class="mt-1.5">
                <a href="{{ path('catalog_index', {genre: book.genre.slug}) }}" class="chip hover:border-accent hover:text-accent">{{ book.genre.name }}</a>
            </p>
        {% endif %}

        {% if book.categories is not empty %}
            <p class="mt-5 text-xs font-medium uppercase tracking-wider text-ink-faint">Thèmes</p>
            <p class="mt-1.5 flex flex-wrap gap-1.5">
                {% for category in book.categories %}
                    <a href="{{ path('catalog_index', {categorie: category.slug}) }}" class="chip hover:border-accent hover:text-accent">{{ category.name }}</a>
                {% endfor %}
            </p>
        {% endif %}

        {#- Mesure bornee : au-dela d'une soixantaine de caracteres par ligne,
            l'oeil perd le debut de la ligne suivante. -#}
        {% if book.description %}
            <p class="mt-6 max-w-[62ch] whitespace-pre-line leading-relaxed">{{ book.description }}</p>
        {% endif %}

        <dl class="mt-8 grid grid-cols-2 border-t border-line sm:grid-cols-3">
            {% if book.publisher %}
                <div class="border-b border-line py-2.5 pr-4"><dt class="text-xs uppercase tracking-wider text-ink-faint">Éditeur</dt><dd class="mt-0.5 text-sm">{{ book.publisher }}</dd></div>
            {% endif %}
            {% if book.publishedYear %}
                <div class="border-b border-line py-2.5 pr-4"><dt class="text-xs uppercase tracking-wider text-ink-faint">Année</dt><dd class="mt-0.5 text-sm tabular">{{ book.publishedYear }}</dd></div>
            {% endif %}
            {% if book.pageCount %}
                <div class="border-b border-line py-2.5 pr-4"><dt class="text-xs uppercase tracking-wider text-ink-faint">Pages</dt><dd class="mt-0.5 text-sm tabular">{{ book.pageCount }}</dd></div>
            {% endif %}
            {% if book.language %}
                <div class="border-b border-line py-2.5 pr-4"><dt class="text-xs uppercase tracking-wider text-ink-faint">Langue</dt><dd class="mt-0.5 text-sm">{{ book.language }}</dd></div>
            {% endif %}
            {% if book.isbn13 %}
                <div class="border-b border-line py-2.5 pr-4"><dt class="text-xs uppercase tracking-wider text-ink-faint">ISBN</dt><dd class="mt-0.5 text-sm tabular">{{ book.isbn13 }}</dd></div>
            {% endif %}
        </dl>
    </div>
</div>
{% endblock %}
