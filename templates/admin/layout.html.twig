{% extends 'base.html.twig' %}

{% block body %}
{#- Une seule definition des sections, pour que l'etat actif ne se desynchronise pas. -#}
{% set sections = [
    {label: 'Livres',     route: 'admin_book_index',     prefixe: 'admin_book'},
    {label: 'Rayons',     route: 'admin_genre_index',    prefixe: 'admin_genre'},
    {label: 'Catégories', route: 'admin_category_index', prefixe: 'admin_category'},
    {label: 'Prêts',      route: 'admin_loan_index',     prefixe: 'admin_loan'}
] %}
{% set routeCourante = app.request.attributes.get('_route') %}

<div class="min-h-screen">
    {#- En-tete colle en haut : sa hauteur est donc du terrain perdu sur toutes les
        pages. Deux rangees fixes valent mieux qu'un repli qui en produit trois sur
        telephone. -#}
    <header class="sticky top-0 z-10 border-b border-line bg-surface">
        <div class="mx-auto max-w-6xl px-5">
            <div class="flex items-center justify-between gap-4 py-2.5">
                <a href="{{ path('admin_dashboard') }}" class="font-display font-semibold tracking-tight whitespace-nowrap">
                    Administration
                </a>
                {#- L'action principale reste a portee de pouce, en bas a droite du
                    bloc : on catalogue debout, une main sur l'etagere. -#}
                <a href="{{ path('admin_book_scan') }}" class="btn btn-primary min-h-10 px-4 text-sm">Scanner</a>
            </div>

            {#- Defilement horizontal plutot que repli : la hauteur reste constante
                quel que soit le nombre de sections. -#}
            <nav class="-mx-5 flex items-center gap-1 overflow-x-auto px-5 pb-2 text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                 aria-label="Sections de l'administration">
                {% for section in sections %}
                    {% set actif = routeCourante starts with section.prefixe %}
                    <a href="{{ path(section.route) }}"
                       {{ actif ? 'aria-current="page"' }}
                       class="shrink-0 rounded-xs px-2.5 py-1.5 whitespace-nowrap
                              {{ actif ? 'bg-surface-sunk font-medium text-ink' : 'text-ink-muted hover:text-accent' }}">
                        {{ section.label }}
                    </a>
                {% endfor %}

                <span class="mx-1 h-4 w-px shrink-0 bg-line" aria-hidden="true"></span>

                <a href="{{ path('home') }}" class="shrink-0 px-2.5 py-1.5 whitespace-nowrap text-ink-muted hover:text-accent">Voir le site</a>
                <a href="{{ path('app_logout') }}" class="shrink-0 px-2.5 py-1.5 whitespace-nowrap text-ink-muted hover:text-accent">Quitter</a>
            </nav>
        </div>
    </header>

    <main class="mx-auto max-w-6xl px-5 py-6 sm:py-8">
        {% for label, messages in app.flashes(['success', 'error']) %}
            {% for message in messages %}
                <div class="alert {{ label == 'success' ? 'alert-success' : 'alert-error' }} mb-5 text-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block admin_content %}{% endblock %}
    </main>
</div>
{% endblock %}
