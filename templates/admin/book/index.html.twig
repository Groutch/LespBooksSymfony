{% extends 'admin/layout.html.twig' %}

{% block title %}Livres{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">
        Livres <span class="font-sans text-lg font-normal text-ink-faint tabular">({{ total }})</span>
    </h1>
    <a href="{{ path('admin_book_new') }}" class="text-sm text-accent hover:underline">Ajouter sans scanner</a>
</div>

<form method="get" class="mt-5 flex max-w-2xl gap-2">
    <label for="recherche-admin" class="sr-only">Rechercher un livre</label>
    <input id="recherche-admin" type="search" name="q" value="{{ criteria.query }}" class="field"
           placeholder="Titre, auteur, ISBN, éditeur…">
    <button type="submit" class="btn btn-primary shrink-0">Chercher</button>
</form>

{% if total == 0 %}
    <p class="mt-6 rounded-xs border border-dashed border-line-field p-10 text-center text-ink-muted">
        Aucun livre. <a href="{{ path('admin_book_scan') }}" class="text-accent hover:underline">Scannez le premier</a>.
    </p>
{% else %}
    <ul class="surface mt-5 divide-y divide-line">
        {% for book in books %}
            <li class="flex flex-wrap items-center gap-3 px-4 py-3">
                {% if book.primaryImage and book.primaryImage.imageName %}
                    <img src="{{ vich_uploader_asset(book.primaryImage, 'imageFile') }}" alt=""
                         class="h-16 w-11 shrink-0 rounded-xs bg-surface-sunk object-cover shadow-cover">
                {% else %}
                    <div class="h-16 w-11 shrink-0 rounded-xs bg-surface-sunk shadow-cover"></div>
                {% endif %}

                <div class="min-w-0 flex-1">
                    <p class="truncate font-medium">{{ book.title }}</p>
                    <p class="truncate text-sm text-ink-muted">
                        {{ book.authorNames|default('Auteur inconnu') }}
                        {% if book.publishedYear %} · <span class="tabular">{{ book.publishedYear }}</span>{% endif %}
                    </p>
                    {% if not book.available %}
                        {#- L'administration, elle, a le droit de nommer l'emprunteur. -#}
                        <span class="chip chip-warn mt-1 text-xs">Prêté à {{ book.activeLoan.borrowerName }}</span>
                    {% endif %}
                </div>

                {#- Sur telephone les deux actions passent sous le titre : cote a cote
                    elles gelaient 180 px et ne laissaient qu'une centaine de pixels au
                    titre, tronque des le troisieme mot. La ligne gagne en hauteur, mais
                    le nom du livre est la seule chose qu'on cherche dans cette liste. -#}
                <div class="flex w-full shrink-0 items-center justify-end gap-2 sm:w-auto sm:justify-start">
                    {% if book.available %}
                        <a href="{{ path('admin_loan_new', {id: book.id}) }}" class="btn btn-ghost px-3 text-sm">Prêter</a>
                    {% else %}
                        <form method="post" action="{{ path('admin_loan_return', {id: book.activeLoan.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('rendre-pret-' ~ book.activeLoan.id) }}">
                            <button type="submit" class="btn btn-ghost px-3 text-sm">Rendre</button>
                        </form>
                    {% endif %}
                    <a href="{{ path('admin_book_edit', {id: book.id}) }}" class="btn btn-ghost px-3 text-sm">Modifier</a>
                </div>
            </li>
        {% endfor %}
    </ul>

    {% if pageCount > 1 %}
        <nav class="mt-6 flex flex-wrap gap-1.5" aria-label="Pagination">
            {% for p in 1..pageCount %}
                <a href="{{ path('admin_book_index', {q: criteria.query, page: p}) }}"
                   {{ p == criteria.page ? 'aria-current="page"' }}
                   class="tabular rounded-xs px-3 py-2 text-sm {{ p == criteria.page ? 'bg-accent text-surface' : 'border border-line bg-surface hover:border-accent hover:text-accent' }}">{{ p }}</a>
            {% endfor %}
        </nav>
    {% endif %}
{% endif %}
{% endblock %}
