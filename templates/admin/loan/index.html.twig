{% extends 'admin/layout.html.twig' %}

{% block title %}Prêts{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">
        Prêts en cours <span class="font-sans text-lg font-normal text-ink-faint tabular">({{ activeLoans|length }})</span>
    </h1>
    <a href="{{ path('admin_book_index') }}" class="text-sm text-accent hover:underline">Prêter un livre</a>
</div>

{% if activeLoans is empty %}
    <p class="mt-6 rounded-xs border border-dashed border-line-field p-10 text-center text-ink-muted">
        Aucun prêt en cours. Depuis la <a href="{{ path('admin_book_index') }}" class="text-accent hover:underline">liste des livres</a>,
        utilisez le bouton « Prêter ».
    </p>
{% else %}
    <ul class="mt-5 space-y-3">
        {% for loan in activeLoans %}
            <li class="surface p-4 {{ loan.overdue ? 'border-warning-line bg-warning-wash' }}">
                <div class="flex flex-wrap items-start justify-between gap-3">
                    <div class="min-w-0">
                        <p class="font-medium">{{ loan.book.title }}</p>
                        <p class="text-sm text-ink-muted">
                            Prêté à {{ loan.borrowerName }} le <time datetime="{{ loan.borrowedAt|date('Y-m-d') }}">{{ loan.borrowedAt|date('d/m/Y') }}</time>
                        </p>
                        <p class="mt-1 text-sm {{ loan.overdue ? 'font-medium text-warning' : 'text-ink-muted' }}">
                            {% if loan.dueAt %}
                                Retour prévu le <time datetime="{{ loan.dueAt|date('Y-m-d') }}">{{ loan.dueAt|date('d/m/Y') }}</time>{% if loan.overdue %} — en retard{% endif %}
                            {% else %}
                                Sans échéance
                            {% endif %}
                        </p>
                        {% if loan.notes %}
                            <p class="mt-1 text-sm italic text-ink-muted">{{ loan.notes }}</p>
                        {% endif %}
                    </div>

                    <div class="flex shrink-0 flex-wrap items-center gap-2">
                        <form method="post" action="{{ path('admin_loan_extend', {id: loan.id}) }}" class="flex items-center gap-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('prolonger-pret-' ~ loan.id) }}">
                            <label for="echeance-{{ loan.id }}" class="sr-only">Nouvelle échéance</label>
                            <input id="echeance-{{ loan.id }}" type="date" name="dueAt"
                                   value="{{ (loan.dueAt ?? date())|date_modify('+' ~ defaultLoanDays ~ ' days')|date('Y-m-d') }}"
                                   class="field w-auto text-sm">
                            <button type="submit" class="btn btn-ghost px-3 text-sm">Prolonger</button>
                        </form>

                        <form method="post" action="{{ path('admin_loan_return', {id: loan.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('rendre-pret-' ~ loan.id) }}">
                            <button type="submit" class="btn btn-primary px-3 text-sm">Rendre</button>
                        </form>
                    </div>
                </div>
            </li>
        {% endfor %}
    </ul>
{% endif %}

{% if returnedLoans is not empty %}
    <h2 class="mt-10 font-display text-xl font-semibold tracking-tight">Derniers retours</h2>
    <ul class="surface mt-4 divide-y divide-line">
        {% for loan in returnedLoans %}
            <li class="px-4 py-3">
                <p class="font-medium">{{ loan.book.title }}</p>
                <p class="text-sm text-ink-muted">
                    {{ loan.borrowerName }} — rendu le <time datetime="{{ loan.returnedAt|date('Y-m-d') }}">{{ loan.returnedAt|date('d/m/Y') }}</time>
                </p>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}
