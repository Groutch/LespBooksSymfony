{% extends 'admin/layout.html.twig' %}

{% block title %}Scanner un livre{% endblock %}

{% block admin_content %}
<div data-controller="barcode-scanner"
     data-barcode-scanner-check-url-value="{{ path('admin_book_check', {isbn: '0000000000000'}) }}"
     data-barcode-scanner-new-url-value="{{ path('admin_book_new') }}">

    <h1 class="font-display text-2xl font-semibold tracking-tight">Scanner un livre</h1>
    <p class="mt-1 text-sm text-ink-muted">Visez le code-barres au dos de l'ouvrage.</p>

    <div class="surface mt-5 p-4">
        <video data-barcode-scanner-target="video"
               class="hidden aspect-video w-full max-w-md rounded-xs bg-ink object-cover"
               playsinline muted></video>

        {#- Le code lu declenchait une navigation quasi instantanee : le benevole ne
            voyait qu'un clignotement et croyait a un plantage. Ce panneau prend la
            place de la video et reste affiche au moins 700 ms. Le vert est celui des
            jetons (5,29:1 sur son halo), le glyphe est decoratif donc masque a l'ARIA. -#}
        <div data-barcode-scanner-target="confirmation"
             class="hidden aspect-video w-full max-w-md flex-col items-center justify-center gap-3 rounded-xs bg-success-wash text-success">
            <span class="relative flex size-14 items-center justify-center">
                <span class="absolute size-14 animate-ping rounded-full bg-success opacity-40 motion-reduce:hidden" aria-hidden="true"></span>
                <span class="relative flex size-14 items-center justify-center rounded-full bg-success text-3xl text-paper" aria-hidden="true">&check;</span>
            </span>
            <p class="font-display text-lg font-semibold">Code détecté</p>
            <p data-barcode-scanner-target="detected" class="tabular text-sm"></p>
        </div>

        {#- `role=status` fait annoncer chaque changement d'etat aux lecteurs d'ecran,
            qui ne voient ni l'animation ni le sablier. -#}
        <p data-barcode-scanner-target="status" role="status" class="mt-3 flex items-center gap-2 text-sm text-ink-muted">
            <span data-barcode-scanner-target="spinner" aria-hidden="true"
                  class="hidden size-4 shrink-0 animate-spin rounded-full border-2 border-current border-t-transparent motion-reduce:animate-none"></span>
            <span data-barcode-scanner-target="statusText">La caméra nécessite une connexion sécurisée (HTTPS) et votre autorisation.</span>
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-action="barcode-scanner#start" class="btn btn-primary">Activer la caméra</button>
            <button type="button" data-action="barcode-scanner#stopManually" class="btn btn-ghost">Arrêter</button>
        </div>
    </div>

    <form class="surface mt-6 p-4" data-action="barcode-scanner#submitManual">
        <label for="manual-isbn" class="mb-1 block text-sm font-medium">Ou saisir l'ISBN à la main</label>
        <div class="flex gap-2">
            <input id="manual-isbn" type="text" inputmode="numeric" placeholder="978…"
                   data-barcode-scanner-target="manual" class="field tabular">
            <button type="submit" class="btn btn-primary shrink-0">Rechercher</button>
        </div>
    </form>

    <p class="mt-5 text-sm">
        <a href="{{ path('admin_book_new') }}" class="text-accent hover:underline">Ajouter un livre sans ISBN</a>
    </p>
</div>
{% endblock %}
