{% extends 'admin/layout.html.twig' %}

{% block title %}Scanner un livre{% endblock %}

{% block admin_content %}
<div data-controller="barcode-scanner"
     data-barcode-scanner-lookup-url-value="{{ path('admin_book_lookup', {isbn: '0000000000000'}) }}"
     data-barcode-scanner-new-url-value="{{ path('admin_book_new') }}">

    <h1 class="font-display text-2xl font-semibold tracking-tight">Scanner un livre</h1>
    <p class="mt-1 text-sm text-ink-muted">Visez le code-barres au dos de l'ouvrage.</p>

    <div class="surface mt-5 p-4">
        <video data-barcode-scanner-target="video"
               class="hidden aspect-video w-full max-w-md rounded-xs bg-ink object-cover"
               playsinline muted></video>

        <p data-barcode-scanner-target="status" class="mt-3 text-sm text-ink-muted">
            La caméra nécessite une connexion sécurisée (HTTPS) et votre autorisation.
        </p>

        <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-action="barcode-scanner#start" class="btn btn-primary">Activer la caméra</button>
            <button type="button" data-action="barcode-scanner#stop" class="btn btn-ghost">Arrêter</button>
        </div>
    </div>

    <form class="surface mt-6 p-4" data-action="barcode-scanner#submitManual">
        <label for="manual-isbn" class="mb-1 block text-sm font-medium">Ou saisir l'ISBN à la main</label>
        <div class="flex gap-2">
            <input id="manual-isbn" type="text" inputmode="numeric" placeholder="978…"
                   data-barcode-scanner-target="manual" class="field tabular">
            <button type="submit" class="btn btn-primary shrink-0">Rechercher</button>
        </div>
    </form>

    <p class="mt-5 text-sm">
        <a href="{{ path('admin_book_new') }}" class="text-accent hover:underline">Ajouter un livre sans ISBN</a>
    </p>
</div>
{% endblock %}
