{% macro fields(form, knownCategories) %}
    <div class="grid gap-x-4 sm:grid-cols-2">
        <div class="sm:col-span-2">{{ form_row(form.title) }}</div>
        <div class="sm:col-span-2">{{ form_row(form.subtitle) }}</div>
        <div class="sm:col-span-2">{{ form_row(form.authorsText) }}</div>

        <div class="sm:col-span-2">
            {{ form_row(form.categoriesText, {attr: {list: 'categories-connues'}}) }}
            <datalist id="categories-connues">
                {% for category in knownCategories %}
                    <option value="{{ category.name }}"></option>
                {% endfor %}
            </datalist>
        </div>

        {{ form_row(form.genre) }}
        {{ form_row(form.shelfLocation) }}
        {{ form_row(form.isbn13) }}
        {{ form_row(form.isbn10) }}
        {{ form_row(form.publisher) }}
        {{ form_row(form.publishedYear) }}
        {{ form_row(form.pageCount) }}
        {{ form_row(form.language) }}

        <div class="sm:col-span-2">{{ form_row(form.description) }}</div>
        {#- Photo de couverture : l'appareil photo du telephone, puis un recadrage qui
            redresse la couverture (cover_capture_controller.js). Sans JavaScript, le
            champ fichier d'origine reste seul, et suffit ; avec, il est masque mais
            c'est toujours lui qui part avec le formulaire. -#}
        <div class="mb-5 sm:col-span-2" data-controller="cover-capture">
            {{ form_label(form.coverFile) }}
            {{ form_widget(form.coverFile, {attr: form.coverFile.vars.attr|merge({'data-cover-capture-target': 'input'})}) }}

            <div data-cover-capture-target="actions" class="hidden">
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                    <button type="button" data-action="cover-capture#photographier" class="btn btn-ghost border-accent text-accent">
                        Photographier la couverture
                    </button>
                    <button type="button" data-action="cover-capture#choisir"
                            class="min-h-11 text-sm text-accent underline underline-offset-2 hover:no-underline">
                        Choisir une image
                    </button>
                </div>
                {#- Sans attribut name : ces deux champs ne partent pas avec le formulaire.
                    `capture` ouvre l'appareil photo, sans passer par la galerie. -#}
                <input type="file" accept="image/jpeg,image/png,image/webp" capture="environment" class="hidden"
                       data-cover-capture-target="camera" data-action="change->cover-capture#charger">
                <input type="file" accept="image/jpeg,image/png,image/webp" class="hidden"
                       data-cover-capture-target="gallery" data-action="change->cover-capture#charger">
                <img data-cover-capture-target="result" alt="Couverture redressée, envoyée à l'enregistrement"
                     class="mt-3 hidden h-44 w-auto rounded-xs shadow-cover">
            </div>
            <p data-cover-capture-target="message" role="alert" class="mt-2 hidden text-sm text-danger"></p>
            {{ form_help(form.coverFile) }}
            {{ form_errors(form.coverFile) }}

            {{ _self.recadrage() }}
        </div>
    </div>
{% endmacro %}

{#- Plein ecran, en deux volets. Le viseur : la camera dans la page et un
    declencheur — l'appareil photo du systeme imposait apres chaque prise un ecran
    « Reessayer / OK », une etape de trop a chaque livre. Le recadrage : la photo,
    le cadre a quatre poignees (assez grosses pour le doigt), deux quarts de tour,
    puis Reprendre ou Valider ; le cadre est dessine en SVG par-dessus la photo.
    `hidden` vit sur les enveloppes des volets, dont rien d'autre ne fixe le display. -#}
{% macro recadrage() %}
    <dialog data-cover-capture-target="editor" aria-label="Photo de couverture"
            data-action="resize@window->cover-capture#dessinerCadre close->cover-capture#ferme"
            class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink p-0 text-paper backdrop:bg-ink">
        <div data-cover-capture-target="viseur" class="hidden h-full">
            <div class="flex h-full flex-col pt-[env(safe-area-inset-top)]">
                <div class="flex items-center gap-2 px-2 pt-2">
                    <button type="button" data-action="cover-capture#annuler" class="min-h-11 px-3 text-sm">Annuler</button>
                    <p class="font-medium outline-none" tabindex="-1" autofocus>Photographier la couverture</p>
                </div>
                <p data-cover-capture-target="viseurStatus" role="status" class="px-5 pb-3 text-sm text-paper/80"></p>

                <div class="flex min-h-0 flex-1 items-center justify-center px-4">
                    <video data-cover-capture-target="video" playsinline muted
                           class="block h-auto max-h-full w-auto max-w-full rounded-xs"></video>
                </div>

                <div class="flex flex-col items-center gap-3 px-4 pt-5 pb-[calc(1.25rem_+_env(safe-area-inset-bottom))]">
                    <button type="button" data-cover-capture-target="shutter" data-action="cover-capture#declencher"
                            aria-label="Prendre la photo" disabled
                            class="size-18 cursor-pointer rounded-full border-4 border-paper bg-paper/85 transition active:scale-95 disabled:opacity-40"></button>
                    <button type="button" data-cover-capture-target="natif" data-action="cover-capture#appareilNatif"
                            class="hidden min-h-11 text-sm underline underline-offset-2">Utiliser l'appareil photo du téléphone</button>
                </div>
            </div>
        </div>

        <div data-cover-capture-target="recadreur" class="hidden h-full">
        <div class="flex h-full flex-col pt-[env(safe-area-inset-top)]">
            <div class="flex items-center gap-2 px-2 pt-2">
                <button type="button" data-action="cover-capture#annuler" class="min-h-11 px-3 text-sm">Annuler</button>
                {#- Le focus a l'ouverture va au titre, et non au premier bouton : un
                    anneau de focus sur « Annuler » laissait croire a un bouton actif. -#}
                <p id="recadrage-titre" class="font-medium outline-none" tabindex="-1" autofocus>Recadrer la couverture</p>
            </div>
            <p data-cover-capture-target="status" role="status" class="px-5 pb-3 text-sm text-paper/80"></p>

            <div class="flex min-h-0 flex-1 items-center justify-center px-4">
                <div class="relative">
                    <canvas data-cover-capture-target="canvas"
                            class="block h-auto max-h-[calc(100dvh_-_14rem)] w-auto max-w-full"></canvas>
                    <svg data-cover-capture-target="overlay" preserveAspectRatio="none" aria-hidden="true"
                         class="absolute inset-0 size-full touch-none"
                         data-action="pointerdown->cover-capture#saisir pointermove->cover-capture#deplacer pointerup->cover-capture#lacher pointercancel->cover-capture#lacher">
                        <polygon data-cover-capture-target="polygon" class="fill-paper/15 stroke-paper"></polygon>
                        {% for coin in 1..4 %}
                            <circle data-cover-capture-target="handle" class="fill-accent stroke-paper"></circle>
                        {% endfor %}
                    </svg>
                </div>
            </div>

            <div class="flex justify-center gap-4 py-3">
                <button type="button" aria-label="Tourner d'un quart de tour à gauche"
                        data-action="cover-capture#tourner" data-cover-capture-sens-param="-1"
                        class="flex size-11 items-center justify-center rounded-full bg-paper/15">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9a9 9 0 1 1 2.6 9.4"/><path d="M3 3v6h6"/></svg>
                </button>
                <button type="button" aria-label="Tourner d'un quart de tour à droite"
                        data-action="cover-capture#tourner" data-cover-capture-sens-param="1"
                        class="flex size-11 items-center justify-center rounded-full bg-paper/15">
                    <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 9a9 9 0 1 0-2.6 9.4"/><path d="M21 3v6h-6"/></svg>
                </button>
            </div>

            <div class="grid grid-cols-2 gap-3 px-4 pb-[calc(1rem_+_env(safe-area-inset-bottom))]">
                {#- Pas de `btn-ghost` : son fond clair, fait pour les pages, rendait le
                    libelle illisible sur le fond sombre de l'ecran de recadrage. -#}
                <button type="button" data-action="cover-capture#reprendre" class="btn border-paper/40 text-paper hover:bg-paper/10">Reprendre</button>
                <button type="button" data-cover-capture-target="validate" data-action="cover-capture#valider" class="btn btn-primary">Valider</button>
            </div>
        </div>
        </div>
    </dialog>
{% endmacro %}

{#- Barre d'enregistrement des formulaires de livre. Au telephone, elle reste
    collee en bas, au-dessus de la barre d'onglets (4rem, sa bordure, puis la zone
    sure de l'iPhone) : en serie, on ne descend plus sous la description et la
    couverture a chaque livre. Sur ordinateur, elle reprend sa place sous le
    formulaire. Les marges negatives la font deborder du `p-4` de la surface. -#}
{% macro actionBarClasses() -%}
    sticky bottom-[calc(4rem_+_1px_+_env(safe-area-inset-bottom))] z-10 -mx-4 -mb-4 flex flex-wrap gap-2 border-t border-line bg-surface px-4 py-3 sm:static sm:mx-0 sm:mb-0 sm:border-0 sm:bg-transparent sm:p-0
{%- endmacro %}
