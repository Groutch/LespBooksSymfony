{% extends 'public/layout.html.twig' %}

{#- Servie par Symfony hors mode debug (apercu : /_error/404). Un lien mort vers
    une fiche est le cas le plus probable : on rend aussitot la recherche. -#}

{% block title %}Page introuvable{% endblock %}

{% block public_content %}
<section class="max-w-xl">
    <p class="text-xs font-medium uppercase tracking-wider text-ink-faint">Erreur 404</p>
    <h1 class="mt-2 font-display text-3xl font-semibold tracking-tight">Page introuvable</h1>
    <p class="mt-3 text-ink-muted">
        Cette page n'existe pas, ou plus : un livre retiré du catalogue emporte sa fiche avec lui.
    </p>

    <form method="get" action="{{ path('catalog_index') }}" class="mt-6 flex gap-2">
        <label for="recherche-erreur" class="sr-only">Rechercher un livre</label>
        <input id="recherche-erreur" type="search" name="q" class="field" placeholder="Titre, auteur, éditeur, ISBN…">
        <button type="submit" class="btn btn-primary shrink-0">Chercher</button>
    </form>

    <p class="mt-6 text-sm">
        <a href="{{ path('home') }}" class="text-accent hover:underline">Revenir à l'accueil</a>
    </p>
</section>
{% endblock %}
