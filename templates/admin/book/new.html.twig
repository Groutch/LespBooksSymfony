{% extends 'admin/layout.html.twig' %}
{% import 'admin/book/_form_fields.html.twig' as fields %}

{% block title %}Ajouter un livre{% endblock %}

{% block admin_content %}
<div data-controller="isbn-autofill"
     data-isbn-autofill-lookup-url-value="{{ path('admin_book_lookup', {isbn: '0000000000000'}) }}"
     data-isbn-autofill-isbn-value="{{ prefillIsbn ?? '' }}">

    <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h1 class="font-display text-2xl font-semibold tracking-tight">Ajouter un livre</h1>
        <a href="{{ path('admin_book_scan') }}" class="text-sm text-accent hover:underline">Scanner un autre code</a>
    </div>

    {% if prefillIsbn %}
        {#- Les trois sources repondent en 2 a 12 s. Le message discret d'avant se
            confondait avec les libelles du formulaire : le benevole voyait un
            formulaire vide et croyait le scan perdu. L'accent sur son halo donne
            6,32:1, au-dessus du seuil AA. -#}
        <p data-isbn-autofill-target="status" role="status"
           class="alert mt-4 flex items-center gap-3 border-accent-wash bg-accent-wash text-sm text-accent">
            <span data-isbn-autofill-target="spinner" aria-hidden="true"
                  class="size-4 shrink-0 animate-spin rounded-full border-2 border-current border-t-transparent motion-reduce:animate-none"></span>
            <span data-isbn-autofill-target="statusText">Recherche des informations du livre…</span>
        </p>
    {% endif %}

    {{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
        <img data-isbn-autofill-target="coverPreview" alt="Couverture proposée"
             class="mb-5 hidden h-44 w-auto rounded-xs shadow-cover">
        <input type="hidden" name="coverUrl" value="" data-isbn-autofill-target="coverUrl">

        {{ fields.fields(form, knownCategories) }}

        <div class="flex flex-wrap gap-2">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <button type="submit" name="saveAndScan" value="1" class="btn btn-ghost border-accent text-accent">
                Enregistrer et scanner le suivant
            </button>
            <a href="{{ path('admin_book_index') }}" class="btn btn-ghost">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
