{% extends 'admin/layout.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">
        Catégories <span class="font-sans text-lg font-normal text-ink-faint tabular">({{ rows|length }})</span>
    </h1>
    <a href="{{ path('admin_category_new') }}" class="text-sm text-accent hover:underline">Nouvelle catégorie</a>
</div>

{% if duplicates is not empty %}
    <div class="alert mt-6 border-warning-line bg-warning-wash p-4">
        <h2 class="font-display font-semibold text-warning">Doublons possibles</h2>
        <p class="mt-1 max-w-[62ch] text-sm text-warning">
            Fusionner conserve tous les livres : ils sont rattachés à la catégorie gardée.
        </p>
        <ul class="mt-3 space-y-2">
            {% for pair in duplicates %}
                <li class="flex flex-wrap items-center gap-2 rounded-xs bg-surface px-3 py-2 text-sm text-ink">
                    <span class="font-medium">{{ pair.first.name }}</span>
                    <span class="text-ink-faint" aria-hidden="true">↔</span>
                    <span class="font-medium">{{ pair.second.name }}</span>
                    <span class="text-xs text-ink-faint tabular">{{ (pair.score * 100)|round }} %</span>

                    <span class="ml-auto flex flex-wrap gap-2">
                        <form method="post" action="{{ path('admin_category_merge') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('fusionner-categories') }}">
                            <input type="hidden" name="source" value="{{ pair.second.id }}">
                            <input type="hidden" name="target" value="{{ pair.first.id }}">
                            <button type="submit" class="btn btn-ghost min-h-0 px-3 py-1.5 text-sm">Garder « {{ pair.first.name }} »</button>
                        </form>
                        <form method="post" action="{{ path('admin_category_merge') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('fusionner-categories') }}">
                            <input type="hidden" name="source" value="{{ pair.first.id }}">
                            <input type="hidden" name="target" value="{{ pair.second.id }}">
                            <button type="submit" class="btn btn-ghost min-h-0 px-3 py-1.5 text-sm">Garder « {{ pair.second.name }} »</button>
                        </form>
                    </span>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endif %}

{% if rows is empty %}
    <p class="mt-6 rounded-xs border border-dashed border-line-field p-10 text-center text-ink-muted">
        Aucune catégorie. Elles se créent aussi toutes seules au fil des scans.
    </p>
{% else %}
    <ul class="surface mt-5 divide-y divide-line">
        {% for row in rows %}
            <li class="flex items-center gap-3 px-4 py-3">
                <div class="min-w-0 flex-1">
                    <p class="truncate font-medium">{{ row.category.name }}</p>
                    <p class="text-sm text-ink-muted">
                        {{ row.bookCount }} livre{{ row.bookCount > 1 ? 's' }}
                        {% if row.category.shelfCode %} · rayon {{ row.category.shelfCode }}{% endif %}
                    </p>
                </div>
                <a href="{{ path('admin_category_edit', {id: row.category.id}) }}" class="btn btn-ghost shrink-0 px-3 text-sm">Modifier</a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
{% endblock %}
