{% extends 'admin/layout.html.twig' %}

{% block title %}Nouvelle catégorie{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Nouvelle catégorie</h1>
    <a href="{{ path('admin_category_index') }}" class="text-sm text-ink-muted hover:text-accent">Retour à la liste</a>
</div>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    <div class="grid gap-x-4 sm:grid-cols-2">
        {{ form_row(form.name) }}
        {{ form_row(form.shelfCode) }}
        <div class="sm:col-span-2">{{ form_row(form.description) }}</div>
    </div>

    {% if suggestions is not empty %}
        <div class="alert mb-5 border-warning-line bg-warning-wash text-sm">
            <p class="font-medium text-warning">Ces catégories existent déjà :</p>
            <ul class="mt-1 space-y-1 text-warning">
                {% for suggestion in suggestions %}
                    <li>
                        <a href="{{ path('admin_category_edit', {id: suggestion.category.id}) }}" class="underline underline-offset-2">{{ suggestion.category.name }}</a>
                        <span class="text-xs tabular">({{ (suggestion.score * 100)|round }} %)</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="flex flex-wrap gap-2">
        <button type="submit" {% if suggestions is not empty %}name="confirm" value="1"{% endif %} class="btn btn-primary">
            {{ suggestions is empty ? 'Créer' : 'Créer quand même' }}
        </button>
        <a href="{{ path('admin_category_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
{{ form_end(form) }}
{% endblock %}
