{% extends 'admin/layout.html.twig' %}

{% block title %}Modifier « {{ category.name }} »{% endblock %}

{% block admin_content %}
<div class="flex flex-wrap items-baseline justify-between gap-4">
    <h1 class="font-display text-2xl font-semibold tracking-tight">Modifier « {{ category.name }} »</h1>
    <a href="{{ path('admin_category_index') }}" class="text-sm text-ink-muted hover:text-accent">Retour à la liste</a>
</div>

<p class="mt-1 text-sm text-ink-muted">
    {{ category.books|length }} livre{{ category.books|length > 1 ? 's' }} rattaché{{ category.books|length > 1 ? 's' }}.
</p>

{{ form_start(form, {attr: {class: 'surface mt-5 p-4'}}) }}
    <div class="grid gap-x-4 sm:grid-cols-2">
        {{ form_row(form.name) }}
        {{ form_row(form.shelfCode) }}
        <div class="sm:col-span-2">{{ form_row(form.description) }}</div>
    </div>

    <div class="flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a href="{{ path('admin_category_index') }}" class="btn btn-ghost">Annuler</a>
    </div>
{{ form_end(form) }}

{% if others is not empty %}
    <div class="surface mt-8 p-4">
        <h2 class="font-display font-semibold">Fusionner dans une autre catégorie</h2>
        <p class="mt-1 max-w-[62ch] text-sm text-ink-muted">
            Les livres de « {{ category.name }} » seront rattachés à la catégorie choisie,
            puis « {{ category.name }} » sera supprimée. Aucun livre n'est perdu.
        </p>
        <form method="post" action="{{ path('admin_category_merge') }}" class="mt-4 flex flex-wrap items-center gap-2"
              onsubmit="return confirm('Fusionner « {{ category.name|e('js') }} » dans la catégorie choisie ?');">
            <input type="hidden" name="_token" value="{{ csrf_token('fusionner-categories') }}">
            <input type="hidden" name="source" value="{{ category.id }}">
            <label for="fusion-cible" class="sr-only">Catégorie de destination</label>
            <select id="fusion-cible" name="target" class="field w-auto">
                {% for other in others %}
                    <option value="{{ other.id }}">{{ other.name }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-ghost">Fusionner</button>
        </form>
    </div>
{% endif %}

<form method="post" action="{{ path('admin_category_delete', {id: category.id}) }}" class="mt-8"
      onsubmit="return confirm('Supprimer « {{ category.name|e('js') }} » ? Les livres seront conservés.');">
    <input type="hidden" name="_token" value="{{ csrf_token('supprimer-categorie-' ~ category.id) }}">
    <button type="submit" class="text-sm text-danger underline underline-offset-2 hover:no-underline">Supprimer cette catégorie</button>
</form>
{% endblock %}
